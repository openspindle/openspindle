# Copy to .env (git ignores it) to build releases on this Mac with npm run dist:mac.
# CI sets its own signing and notarization secrets instead; see docs/releasing.md.

# The Developer ID Application certificate in your keychain, named without that prefix.
CSC_NAME="Your Team Name (TEAMID)"

# The notarytool keychain profile, made once with:
#   xcrun notarytool store-credentials openspindle-notary --apple-id you@example.com --team-id TEAMID
APPLE_KEYCHAIN_PROFILE=openspindle-notary

# Error reports (docs/releasing.md, Error reports). Builds, dev runs included, report errors to the
# DSN as the user allows; without one the app only logs them. npm run dist:mac and dist:win upload
# their source maps with the auth token; other builds never upload.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
