{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "packages/*/src/**/*.ts",
    "tools/vite/**/*.ts",
    "tools/packaging/**/*.ts",
    "eslint.config.js",
    "vite.config.ts",
    "electron.vite.config.ts",
    "host/**/*.ts",
    "host/**/*.tsx"
  ],
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
