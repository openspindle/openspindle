{
  "name": "openspindle",
  "private": true,
  "version": "0.2.0",
  "description": "A desktop app for preparing, checking and running jobs on a Makera Z1 CNC machine.",
  "author": "OpenSpindle contributors",
  "license": "MIT",
  "homepage": "https://github.com/openspindle/openspindle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openspindle/openspindle.git"
  },
  "bugs": {
    "url": "https://github.com/openspindle/openspindle/issues"
  },
  "type": "module",
  "main": "out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "node scripts/dev-app-bundle.mjs && node scripts/dev-app-name.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prestart": "node scripts/dev-app-bundle.mjs && node scripts/dev-app-name.mjs",
    "start": "electron-vite preview",
    "prepackage:mac": "test -f node_modules/electron/dist/LICENSES.chromium.html || install-electron",
    "package:mac": "electron-vite build && electron-builder --mac --dir -c.mac.identity=- -c.mac.notarize=false",
    "predist:mac": "test -f node_modules/electron/dist/LICENSES.chromium.html || install-electron",
    "dist:mac": "node --env-file-if-exists=.env node_modules/electron-vite/bin/electron-vite.js build && node --env-file-if-exists=.env node_modules/electron-builder/cli.js --mac",
    "typecheck": "tsc -p tsconfig.json && tsc -p electron/tsconfig.json && tsc -p tools/z1-simulator/tsconfig.json",
    "lint": "eslint src electron packages plugins vite.config.ts electron.vite.config.ts tools",
    "format": "prettier --write src electron packages plugins tools vite.config.ts electron.vite.config.ts",
    "check": "prettier --check src electron packages plugins tools vite.config.ts electron.vite.config.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "icon": "electron scripts/app-icon.mjs",
    "sim:z1": "node tools/z1-simulator/main.ts",
    "sdk:types": "node tools/plugin-sdk/types.ts",
    "prepare": "node tools/plugin-sdk/types.ts"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@sentry/electron": "7.20.0",
    "@sentry/react": "10.75.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/pacer": "^0.22.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^9",
    "fflate": "^0.8.3",
    "lucide-react": "^1.48.0",
    "occt-import-js": "^0.0.23",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.13.3",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "vite": "^8",
    "zod": "^4.6.5"
  }
}
